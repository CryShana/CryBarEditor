<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
		xmlns:cbar="using:CryBar.Bar"
		xmlns:ce="using:CryBarEditor"
		xmlns:cc="using:CryBarEditor.Classes"
		xmlns:controls="using:CryBarEditor.Controls"
		xmlns:converters="using:CryBarEditor.Converters"
		xmlns:micons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
		mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="450"
        x:Class="CryBarEditor.MainWindow"
		DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="CryBarEditor" x:DataType="ce:MainWindow"
		Foreground="#d9d9d9"
		Background="#141414"
		x:Name="mainWindow">
	<Window.Styles>
		<Style Selector="ListBox">
			<Setter Property="Background" Value="#1c1c1c" />
		</Style>
		<Style Selector="TextBlock.BAR">
			<Setter Property="Foreground" Value="#6f96bf"/>
		</Style>
		<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="#2b3c57" />
		</Style>

		<Style Selector="ListBoxItem:focus /template/ ContentPresenter">
			<Setter Property="Background" Value="#2b3c57" />
		</Style>

		<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#1a2436" />
		</Style>

		<Style Selector="Menu MenuItem">
			<Setter Property="Foreground" Value="#ebebeb" />
		</Style>

		<!-- TextBox clear button -->
		<Style Selector="TextBox.clearable">
			<Setter Property="Padding" Value="8,5,26,5" />
		</Style>

		<!-- Override filter toggle -->
		<Style Selector="ToggleButton.overrideFilter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="ToggleButton.overrideFilter:checked">
			<Setter Property="Background" Value="#4772b5" />
		</Style>

		<!-- Structured-preview TabStrip dark theme (TMM + scenario) -->
		<Style Selector="TabStrip.structuredPreviewTabs">
			<Setter Property="Background" Value="#1c1c1c" />
		</Style>
		<Style Selector="TabStrip.structuredPreviewTabs TabStripItem">
			<Setter Property="Background" Value="#1c1c1c" />
			<Setter Property="Foreground" Value="#a0a0a0" />
			<Setter Property="Padding" Value="12,6" />
		</Style>
		<Style Selector="TabStrip.structuredPreviewTabs TabStripItem:selected">
			<Setter Property="Background" Value="#2b3c57" />
			<Setter Property="Foreground" Value="#d9d9d9" />
		</Style>
		<Style Selector="TabStrip.structuredPreviewTabs TabStripItem:pointerover">
			<Setter Property="Background" Value="#1a2436" />
			<Setter Property="Foreground" Value="#d9d9d9" />
		</Style>
	</Window.Styles>
	<Window.Resources>
		<converters:IsOverridenToBoolConverter x:Key="overridenConverter" />
		
		<ContextMenu x:Key="SharedContextMenu" Opened="ContextMenu_Opened">
			<MenuItem Header="Copy file name"
					  Icon="{micons:MaterialIconExt Kind=ContentCopy}"
					  Click="MenuItem_CopyFileName" />

			<MenuItem Header="Copy file path"
					  Icon="{micons:MaterialIconExt Kind=ContentCopy}"
					  Click="MenuItem_CopyFilePath" />

			<Separator IsVisible="{Binding CanOpenRootDirectory}" />

			<MenuItem Header="Open directory"
					IsVisible="{Binding CanOpenRootDirectory}" Icon="{micons:MaterialIconExt Kind=FolderOpen}"
					Click="MenuItem_OpenRootDirectory" />

			<Separator IsVisible="{Binding CanExport}" />

			<MenuItem Header="Open export directory"
					IsVisible="{Binding CanExport}" Icon="{micons:MaterialIconExt Kind=OpenInNew}"
					Click="MenuItem_ExportSelectedOpenDirectory" />

			<MenuItem Header="Open exported in editor"
					IsVisible="{Binding CanOpenInEditor}" Icon="{micons:MaterialIconExt Kind=FileEditOutline}"
					Click="MenuItem_OpenExportedInEditor" />

			<MenuItem Header="{Binding ContextSelectedItemsCount, StringFormat='Export {0} selected (copy)'}"
					IsVisible="{Binding CanExport}" Icon="{micons:MaterialIconExt Kind=Export}"
					Click="MenuItem_ExportSelectedRaw" />

			<MenuItem Header="{Binding ContextSelectedItemsCount, StringFormat='Export {0} selected (converted)'}"
					IsVisible="{Binding CanExport}" Icon="{micons:MaterialIconExt Kind=Export}"
					Click="MenuItem_ExportSelectedConverted" />

			<MenuItem Header="{Binding ContextSelectedItemsCount, StringFormat='Export {0} selected (copy+converted)'}"
					IsVisible="{Binding CanExport}" Icon="{micons:MaterialIconExt Kind=Export}"
					Click="MenuItem_ExportSelectedRawConverted" />

			<MenuItem Header="{Binding ContextSelectedItemsCount, StringFormat='Advanced Export ({0} selected)...'}"
					Icon="{micons:MaterialIconExt Kind=CogOutline}" IsVisible="{Binding CanExport}"
					Click="MenuItem_AdvancedExport" />

			<MenuItem Header="{Binding ContextSelectedItemsCount, StringFormat='Export {0} selected to...'}"
					Icon="{micons:MaterialIconExt Kind=CogOutline}"
					Click="MenuItem_ExportTo" />

			<Separator IsVisible="{Binding CanExportAndIsDDT}"/>

			<MenuItem Header="Replace image and export DDT"
					IsVisible="{Binding CanExportAndIsDDT}" Icon="{micons:MaterialIconExt Kind=FileReplaceOutline}"
					Click="MenuItem_ReplaceImageAndExportDDT"/>

			<Separator IsVisible="{Binding SelectedCanHaveAdditiveMod}"/>

			<MenuItem Header="Create additive mod" Icon="{micons:MaterialIconExt Kind=FileEditOutline}"
					IsVisible="{Binding SelectedCanHaveAdditiveMod}"
					Click="MenuItem_CreateNewAdditiveMod"/>

			<Separator IsVisible="{Binding CanToggleQuickAccess}" />
			<MenuItem Header="{Binding QuickAccessToggleText}"
					  Icon="{micons:MaterialIconExt Kind=Star}"
					  IsVisible="{Binding CanToggleQuickAccess}"
					  Click="MenuItem_ToggleQuickAccess" />

			<Separator IsVisible="{Binding CanShowDependencies}" />
			<MenuItem Header="Show dependencies"
					  Icon="{micons:MaterialIconExt Kind=FileTreeOutline}"
					  IsVisible="{Binding CanShowDependencies}"
					  Click="MenuItem_ShowDependencies" />
		</ContextMenu>
	</Window.Resources>

	<DockPanel>
		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#1c1c1c">
			<TextBlock Text="TOOLS ->" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" />
			<Menu Margin="5,0,0,0">
				<MenuItem Header="_Convert">
					<MenuItem Header="XML to XMB" Click="MenuItem_ConvertXMLtoXMB" />
					<MenuItem Header="XMB to XML" Click="MenuItem_ConvertXMBtoXML" />
					<MenuItem Header="DDT to TGA" Click="MenuItem_ConvertDDTtoTGA" />
					<MenuItem Header="DDT to PNG" Click="MenuItem_ConvertDDTtoPNG" />
					<MenuItem Header="DDS to PNG" Click="MenuItem_ConvertDDStoPNG" />
					<MenuItem Header="Image to DDT" Click="MenuItem_ConvertToDDT" />
					<MenuItem Header="Image to DDS" Click="MenuItem_ConvertPNGtoDDS" />
					<MenuItem Header="TMM to OBJ" Click="MenuItem_ConvertTMMtoOBJ" />
					<MenuItem Header="TMM to glTF" Click="MenuItem_ConvertTMMtoGLTF" />
					<MenuItem Header="GLB to TMM" Click="MenuItem_ConvertGLBtoTMM" />
					<Separator />
					<MenuItem Header="Scenario to XML" Click="MenuItem_ConvertScenarioToXML" />
					<MenuItem Header="XML to Scenario" Click="MenuItem_ConvertXMLtoScenario" />
					<Separator />
					<MenuItem Header="TRG to XML" Click="MenuItem_ConvertTRGtoXML" />
					<MenuItem Header="XML to TRG" Click="MenuItem_ConvertXMLtoTRG" />
					<MenuItem Header="TRG to XS" Click="MenuItem_ConvertTRGtoXS" />
					<MenuItem Header="XS to TRG" Click="MenuItem_ConvertXStoTRG" />
					<MenuItem Header="XS to XML" Click="MenuItem_ConvertXStoXML" />
					<MenuItem Header="XML to XS" Click="MenuItem_ConvertXMLtoXS" />
				</MenuItem>
				<MenuItem Header="Actions">
					<MenuItem Header="Make XS script RM friendly" Click="MenuItem_XStoRM" />
					<MenuItem Header="Open scenario for editing" Click="MenuItem_OpenScenarioForEditing" />
					<MenuItem Header="Extract TRG from scenario" Click="MenuItem_ExtractTRGfromScenario" />
				</MenuItem>
				<MenuItem Header="Compress">
					<MenuItem Header="Alz4" Click="MenuItem_CompressAlz4" />
					<MenuItem Header="L33t" Click="MenuItem_CompressL33t" />
				</MenuItem>
				<MenuItem Header="Decompress" Click="MenuItem_Decompress" />
				<MenuItem Header="Search" Click="MenuItem_Search" />
				<MenuItem Header="Settings" Click="MenuItem_Settings" />
				<MenuItem Header="Help">
					<MenuItem Header="Check for Updates" Click="MenuItem_CheckForUpdates" />
					<MenuItem Header="Blender Export Tips" Click="TipsClick" />
				</MenuItem>
			</Menu>
		</StackPanel>
		<Border Padding="10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="300" MinWidth="200" />
					<ColumnDefinition Width="5" MinWidth="5" />
					<ColumnDefinition Width="400" MinWidth="200" />
					<ColumnDefinition Width="5" MinWidth="5" />
					<ColumnDefinition Width="*" MinWidth="150" />
				</Grid.ColumnDefinitions>

				<!-- ROOT DIRECTORY FILE ENTRIES -->
				<DockPanel Grid.Row="1" Grid.Column="0">
					<Label DockPanel.Dock="Top" Content="Root Directory" FontWeight="Bold"  FontSize="16"/>
					<DockPanel DockPanel.Dock="Top" Margin="0,5,0,0">
						<Button Content="{micons:MaterialIconExt Kind=FolderArrowUpOutline}" Padding="4"
								Click="LoadDir_Click" Margin="0,0,6,6" />
						<TextBlock DockPanel.Dock="Top" Text="{Binding RootDirectory}" Foreground="Gray" Margin="0,4,0,0"
								   Cursor="Hand" PointerPressed="RootDirectoryPath_Click"
								   TextTrimming="CharacterEllipsis" />
					</DockPanel>

					<DockPanel DockPanel.Dock="Top">
						<ToggleButton DockPanel.Dock="Right" Classes="overrideFilter" Margin="4,0,0,0"
									  IsChecked="{Binding FilterOnlyOverriddenFiles, Mode=TwoWay}"
									  ToolTip.Tip="Show only overridden entries"
									  Padding="4" MinWidth="0" MinHeight="0" Cursor="Hand">
							<micons:MaterialIcon Kind="FileExportOutline" Width="16" Height="16" />
						</ToggleButton>
						<Grid>
							<TextBox Classes="clearable" Text="{Binding FilesQuery, Mode=TwoWay}" PlaceholderText="Filter files" TextChanged="FilterTextBox_TextChanged" />
							<Button Classes="filterClear" HorizontalAlignment="Right" VerticalAlignment="Center"
									Focusable="False" IsTabStop="False" Click="FilterClear_Click"
									IsVisible="False" Background="Transparent" BorderThickness="0"
									Padding="2" Margin="0,0,4,0" Cursor="Hand">
								<micons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="#808080" />
							</Button>
						</Grid>
					</DockPanel>
					<TextBlock DockPanel.Dock="Top" Margin="0,6,0,0">
						<Run Text="Guessed Root: " FontWeight="Bold"/>
						<Run Text="{Binding RootFileRootPath}"/>
					</TextBlock>
					<ListBox ItemsSource="{Binding RootFileEntries}" Margin="0,10,0,0"
							 SelectionMode="Multiple"
							 SelectedItems="{Binding SelectedRootFileEntries, Mode=TwoWay}"
							 SelectedItem="{Binding SelectedRootFileEntry, Mode=TwoWay}"
							 Tapped="RootListBox_Tapped"
							 ContextMenu="{StaticResource SharedContextMenu}">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="cc:RootFileEntry">
								<StackPanel Orientation="Horizontal" Height="19">
									<TextBlock Text="{Binding DirectoryPath}" Foreground="#808080" VerticalAlignment="Center"/>
									<TextBlock Text="{Binding Name}" Classes.BAR="{Binding IsBAR}" VerticalAlignment="Center"/>
									<micons:MaterialIcon Kind="FileExportOutline" VerticalAlignment="Center"
														 Margin="5,0,0,0" Foreground="#e3bd54"
														 Width="19" Height="19" Background="Transparent"
														 ToolTip.Tip="Overriden in export directory">
										<micons:MaterialIcon.IsVisible>
											<MultiBinding Converter="{StaticResource overridenConverter}">
												<Binding Path="." />
												<Binding Path="#mainWindow" />
												<Binding Path="#mainWindow.((ce:MainWindow)DataContext).ShowOverridenIcons" />
											</MultiBinding>
										</micons:MaterialIcon.IsVisible>
									</micons:MaterialIcon>
									<micons:MaterialIcon Kind="FilePlusOutline" VerticalAlignment="Center"
														 Margin="3,0,0,0" Foreground="#6ecf8e"
														 Width="19" Height="19" Background="Transparent"
														 ToolTip.Tip="Has additive mod in export directory">
										<micons:MaterialIcon.IsVisible>
											<MultiBinding Converter="{StaticResource overridenConverter}"
														  ConverterParameter="additive">
												<Binding Path="." />
												<Binding Path="#mainWindow" />
												<Binding Path="#mainWindow.((ce:MainWindow)DataContext).ShowOverridenIcons" />
											</MultiBinding>
										</micons:MaterialIcon.IsVisible>
									</micons:MaterialIcon>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</DockPanel>

				<GridSplitter Grid.Row="1" Grid.Column="1" Width="5" Margin="3" />

				<!-- BAR ARCHIVE FILE ENTRIES / FMOD BANK -->
				<Grid Grid.Row="1" Grid.Column="2">
					<!-- BAR File Panel -->
					<DockPanel IsVisible="{Binding !IsBankFileSelected}">
						<Label DockPanel.Dock="Top" Content="BAR File" FontWeight="Bold" FontSize="16"/>
						<DockPanel DockPanel.Dock="Top" Margin="0,5,0,0">
							<Button Content="{micons:MaterialIconExt Kind=ArchiveArrowUpOutline}" Padding="4" Click="LoadBAR_Click" Margin="0,0,6,6"/>
							<Label DockPanel.Dock="Top" Content="{Binding LoadedBARFilePathOrRelative}" Foreground="Gray" Margin="0,2,0,0" />
						</DockPanel>
						<DockPanel DockPanel.Dock="Top">
						<ToggleButton DockPanel.Dock="Right" Classes="overrideFilter" Margin="4,0,0,0"
									  IsChecked="{Binding FilterOnlyOverriddenBarEntries, Mode=TwoWay}"
									  ToolTip.Tip="Show only overridden entries"
									  Padding="4" MinWidth="0" MinHeight="0" Cursor="Hand">
							<micons:MaterialIcon Kind="FileExportOutline" Width="16" Height="16" />
						</ToggleButton>
						<Grid>
							<TextBox Classes="clearable" Text="{Binding EntryQuery, Mode=TwoWay}" PlaceholderText="Filter BAR entries" TextChanged="FilterTextBox_TextChanged" />
							<Button Classes="filterClear" HorizontalAlignment="Right" VerticalAlignment="Center"
									Focusable="False" IsTabStop="False" Click="FilterClear_Click"
									IsVisible="False" Background="Transparent" BorderThickness="0"
									Padding="2" Margin="0,0,4,0" Cursor="Hand">
								<micons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="#808080" />
							</Button>
						</Grid>
						</DockPanel>
						<DockPanel DockPanel.Dock="Top" Margin="0,6,0,0">
							<TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left">
								<Run Text="Root: " FontWeight="Bold"/>
								<Run Text="{Binding BarFileRootPath}"/>
							</TextBlock>
							<TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right">
								<Run Text="Entries: " FontWeight="Bold"/>
								<Run Text="{Binding BarFile?.Entries?.Count}"/>
							</TextBlock>
						</DockPanel>
						
						<ListBox ItemsSource="{Binding BarEntries}" Margin="0,10,0,0"
								SelectionMode="Multiple"
								SelectedItems="{Binding SelectedBarFileEntries, Mode=TwoWay}"
								SelectedItem="{Binding SelectedBarEntry, Mode=TwoWay}"
								Tapped="BarListBox_Tapped"
								ContextMenu="{StaticResource SharedContextMenu}">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="cbar:BarFileEntry">
									<StackPanel Orientation="Horizontal" Height="19">
										<TextBlock Text="{Binding DirectoryPath}" Foreground="#808080" VerticalAlignment="Center"/>
										<TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
										<micons:MaterialIcon Kind="FileExportOutline" VerticalAlignment="Center"
															Margin="5,0,0,0" Foreground="#e3bd54"
															Width="19" Height="19" Background="Transparent"
															ToolTip.Tip="Overriden in export directory">
											<micons:MaterialIcon.IsVisible>
												<MultiBinding Converter="{StaticResource overridenConverter}">
													<Binding Path="." />
													<Binding Path="#mainWindow" />
													<Binding Path="#mainWindow.((ce:MainWindow)DataContext).ShowOverridenIcons" />
												</MultiBinding>
											</micons:MaterialIcon.IsVisible>
										</micons:MaterialIcon>
										<micons:MaterialIcon Kind="FilePlusOutline" VerticalAlignment="Center"
															 Margin="3,0,0,0" Foreground="#6ecf8e"
															 Width="19" Height="19" Background="Transparent"
															 ToolTip.Tip="Has additive mod in export directory">
											<micons:MaterialIcon.IsVisible>
												<MultiBinding Converter="{StaticResource overridenConverter}"
															  ConverterParameter="additive">
													<Binding Path="." />
													<Binding Path="#mainWindow" />
													<Binding Path="#mainWindow.((ce:MainWindow)DataContext).ShowOverridenIcons" />
												</MultiBinding>
											</micons:MaterialIcon.IsVisible>
										</micons:MaterialIcon>
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</DockPanel>

					<!-- FMOD Bank Panel -->
					<DockPanel IsVisible="{Binding IsBankFileSelected}">
						<Label DockPanel.Dock="Top" Content="FMOD Bank" FontWeight="Bold" FontSize="16"/>
						<DockPanel DockPanel.Dock="Top" Margin="0,5,0,0">
							<Button Content="{micons:MaterialIconExt Kind=FileMusic}" Padding="4" Click="LoadBank_Click" Margin="0,0,6,6"/>
							<Label DockPanel.Dock="Top" Content="{Binding LoadedBankFilePathOrRelative}" Foreground="Gray" Margin="0,2,0,0" />
						</DockPanel>
						<Grid DockPanel.Dock="Top">
							<TextBox Classes="clearable" Text="{Binding BankQuery, Mode=TwoWay}" PlaceholderText="Filter events" TextChanged="FilterTextBox_TextChanged" />
							<Button Classes="filterClear" HorizontalAlignment="Right" VerticalAlignment="Center"
									Focusable="False" IsTabStop="False" Click="FilterClear_Click"
									IsVisible="False" Background="Transparent" BorderThickness="0"
									Padding="2" Margin="0,0,4,0" Cursor="Hand">
								<micons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="#808080" />
							</Button>
						</Grid>
						<TextBlock DockPanel.Dock="Top" Margin="0,6,0,0">
							<Run Text="Events: " FontWeight="Bold"/>
							<Run Text="{Binding FmodBank?.Events?.Length}"/>
							<Run Text="    Sounds: " FontWeight="Bold"/>
							<Run Text="{Binding FmodBank?.Subsounds?.Length}"/>
						</TextBlock>
						
						<ListBox ItemsSource="{Binding BankEntries}" Margin="0,10,0,0"
								SelectionMode="Multiple"
								DoubleTapped="BankEntryList_DoubleTapped"
								SelectedItems="{Binding SelectedBankEntries, Mode=TwoWay}"
								SelectedItem="{Binding SelectedBankEntry, Mode=TwoWay}">
							<ListBox.DataTemplates>
								<DataTemplate x:DataType="cc:FMODEvent">
									<StackPanel Orientation="Horizontal" Height="19">
										<Button Click="BankItem_IconPlay" IsVisible="{Binding !IsPlaying}" ToolTip.Tip="Play"
												Padding="0" Margin="0,0,5,0" Width="16" Height="16" Background="Transparent"
												BorderThickness="0" VerticalAlignment="Center" Cursor="Hand">
											<micons:MaterialIcon Kind="MusicNote" Width="16" Height="16" Foreground="#6f96bf"/>
										</Button>
										<Button Click="BankItem_StopPlayback" IsVisible="{Binding IsPlaying}" ToolTip.Tip="Stop"
												Padding="0" Margin="0,0,5,0" Width="16" Height="16" Background="Transparent"
												BorderThickness="0" VerticalAlignment="Center" Cursor="Hand">
											<micons:MaterialIcon Kind="Stop" Width="16" Height="16" Foreground="#d06a5a"/>
										</Button>
										<TextBlock Text="{Binding Path}" VerticalAlignment="Center"/>
									</StackPanel>
								</DataTemplate>
								<DataTemplate x:DataType="cc:FMODSubsound">
									<StackPanel Orientation="Horizontal" Height="19">
										<Button Click="BankItem_IconPlay" IsVisible="{Binding !IsPlaying}" ToolTip.Tip="Play"
												Padding="0" Margin="0,0,5,0" Width="16" Height="16" Background="Transparent"
												BorderThickness="0" VerticalAlignment="Center" Cursor="Hand">
											<micons:MaterialIcon Kind="Waveform" Width="16" Height="16" Foreground="#c89b5a"/>
										</Button>
										<Button Click="BankItem_StopPlayback" IsVisible="{Binding IsPlaying}" ToolTip.Tip="Stop"
												Padding="0" Margin="0,0,5,0" Width="16" Height="16" Background="Transparent"
												BorderThickness="0" VerticalAlignment="Center" Cursor="Hand">
											<micons:MaterialIcon Kind="Stop" Width="16" Height="16" Foreground="#d06a5a"/>
										</Button>
										<TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
									</StackPanel>
								</DataTemplate>
							</ListBox.DataTemplates>
							<ListBox.ContextMenu>
								<ContextMenu Opened="BankContextMenu_Opened">
									<MenuItem Header="Play"
											Icon="{micons:MaterialIconExt Kind=Play}"
											Click="BankItem_Play"
											IsVisible="{Binding #mainWindow.((ce:MainWindow)DataContext).SelectedBankSingle}" />
									<MenuItem Header="Export (copy)"
										Icon="{micons:MaterialIconExt Kind=ContentCopy}"
										Click="BankItem_ExportCopy"
										IsVisible="{Binding #mainWindow.((ce:MainWindow)DataContext).HasExportDirectory}" />
									<MenuItem Header="Export to..."
										Icon="{micons:MaterialIconExt Kind=FolderArrowDownOutline}"
										Click="BankItem_ExportTo" />
									<MenuItem Header="Copy file path"
										Icon="{micons:MaterialIconExt Kind=ContentCopy}"
										Click="BankItem_CopyFilePath"
										IsVisible="{Binding #mainWindow.((ce:MainWindow)DataContext).SelectedBankSingle}" />
									<Separator IsVisible="{Binding #mainWindow.((ce:MainWindow)DataContext).SelectedBankIsEventSingle}" />
									<MenuItem Header="{Binding #mainWindow.((ce:MainWindow)DataContext).FmodQuickAccessToggleText}"
										Icon="{micons:MaterialIconExt Kind=Star}"
										Click="MenuItem_ToggleQuickAccessFmod"
										IsVisible="{Binding #mainWindow.((ce:MainWindow)DataContext).SelectedBankIsEventSingle}" />
									<Separator IsVisible="{Binding #mainWindow.((ce:MainWindow)DataContext).SelectedBankIsEventSingle}" />
									<MenuItem Header="Show dependencies"
										Icon="{micons:MaterialIconExt Kind=FileTreeOutline}"
										Click="MenuItem_ShowDependenciesFmod"
										IsVisible="{Binding #mainWindow.((ce:MainWindow)DataContext).SelectedBankIsEventSingle}" />
								</ContextMenu>
							</ListBox.ContextMenu>
						</ListBox>
					</DockPanel>
				</Grid>

				<GridSplitter Grid.Row="1" Grid.Column="3" Width="5" Margin="3"  />

				<!-- EXPORT SETTINGS + PREVIEWER -->
				<DockPanel Grid.Row="1" Grid.Column="4">
					<DockPanel DockPanel.Dock="Top">
						<Button DockPanel.Dock="Right" Click="QuickAccess_Click"
								Padding="4" Margin="6,0,6,0"
								ToolTip.Tip="Quick Access"
								Background="Transparent" BorderThickness="0" Cursor="Hand">
							<micons:MaterialIcon Kind="Star" Width="18" Height="18" Foreground="#e3bd54" />
						</Button>
						<Label Content="Export Root Directory" FontWeight="Bold" FontSize="16"/>
					</DockPanel>
					<DockPanel DockPanel.Dock="Top" Margin="0,5,0,0">
						<Button Content="{micons:MaterialIconExt Kind=FolderArrowDownOutline}" Padding="4" Click="SelectExportRootDir_Click" Margin="0,0,6,6"/>
						<TextBlock Text="{Binding ExportRootDirectory}" Foreground="Gray" Margin="0,4,0,0"
								   Cursor="Hand" PointerPressed="ExportDirectoryPath_Click"
								   TextTrimming="CharacterEllipsis" />
					</DockPanel>
					<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,0">
						<TextBlock FontSize="16">
							<Run Text="Previewing: " FontWeight="Bold" />
							<Run Text="{Binding PreviewedFileName}" Foreground="#ffe6a1" />
							<Run Text="{Binding PreviewedFileNote}" Foreground="#edc042" />
						</TextBlock>
						<StackPanel Orientation="Horizontal" Margin="8,0,0,0"
									IsVisible="{Binding ShowExperimentalWarning}"
									VerticalAlignment="Center">
							<micons:MaterialIcon Kind="AlertOutline" Width="18" Height="18"
												  Foreground="#e8a33e" VerticalAlignment="Center" />
							<TextBlock Text="EXPERIMENTAL" Foreground="#e8a33e"
									   FontSize="12" FontWeight="Bold" Margin="3,0,0,0"
									   VerticalAlignment="Center" />
						</StackPanel>
					</StackPanel>
					<SelectableTextBlock DockPanel.Dock="Top"
							   Text="{Binding PreviewedFileData}"
							   Margin="0,3,0,13" Foreground="Gray"  />
					<Grid x:Name="_gridPreview">
						<!-- Flat preview for non-TMM files -->
						<Panel x:Name="_flatPreview">
							<Image x:Name="_imgPreview" ZIndex="1"
								HorizontalAlignment="Left" VerticalAlignment="Top"
								Stretch="Uniform" StretchDirection="DownOnly" />
							<ae:TextEditor x:Name="_txtEditor"
								IsReadOnly="True"
								Text="Click on any file to preview it here"
								ShowLineNumbers="True"
								FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
								Background="#1c1c1c"/>
						</Panel>

						<!-- TabStrip + Grid (not TabControl) keeps both panels parented across tabs,
							 so the GL context survives tab toggles. -->
						<Grid x:Name="_tmmRoot" IsVisible="False" RowDefinitions="Auto,*">
							<TabStrip Grid.Row="0" x:Name="_tmmTabStrip"
									  Classes="structuredPreviewTabs"
									  SelectedIndex="0"
									  SelectionChanged="TmmTab_SelectionChanged">
								<TabStripItem>Metadata</TabStripItem>
								<TabStripItem>3D View</TabStripItem>
							</TabStrip>
							<Grid Grid.Row="1">
								<ae:TextEditor x:Name="_tmmMetadataEditor"
									IsReadOnly="True"
									ShowLineNumbers="True"
									FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
									Background="#1c1c1c"/>
								<DockPanel x:Name="_tmm3dPanel" IsVisible="False">
									<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
												HorizontalAlignment="Right" Margin="0,4,0,0">
										<CheckBox x:Name="_showMarkersCheckbox"
												  Content="Show markers"
												  IsChecked="True"
												  IsCheckedChanged="ShowMarkers_Toggled"
												  Margin="0,0,8,0" />
										<CheckBox x:Name="_showGroundGridCheckbox"
												  Content="Show grid"
												  IsChecked="True"
												  IsCheckedChanged="ShowGroundGrid_Toggled"
												  Margin="0,0,8,0" />
										<ToggleButton x:Name="_texturedToggle"
													  Content="Textured"
													  IsVisible="False"
													  IsCheckedChanged="TexturedToggle_Toggled"
													  Margin="0,0,8,0" Padding="6,2" />
										<TextBlock x:Name="_3dStatusText"
											VerticalAlignment="Center" Margin="0,0,8,0"
											Foreground="Gray" />
										<Button Click="Screenshot_Click" Padding="6,2" Margin="0,0,8,0"
											ToolTip.Tip="Render current view to an image file">
											<StackPanel Orientation="Horizontal" Spacing="4">
												<micons:MaterialIcon Kind="CameraOutline" Width="14" Height="14"/>
												<TextBlock Text="Screenshot"/>
											</StackPanel>
										</Button>
										<Button Content="Reset Camera"
											Click="ResetCamera_Click" Padding="6,2" />
									</StackPanel>
									<Grid>
										<Border x:Name="_3dViewContainer" Background="#0a0a0a" />
										<Canvas x:Name="_3dLabelCanvas" IsHitTestVisible="False" />
									</Grid>
								</DockPanel>
							</Grid>
						</Grid>

						<Grid x:Name="_scenarioRoot" IsVisible="False" RowDefinitions="Auto,*"
							  Focusable="True" KeyDown="ScenarioRoot_KeyDown">
							<TabStrip Grid.Row="0" x:Name="_scenarioTabStrip"
									  Classes="structuredPreviewTabs"
									  SelectedIndex="0"
									  SelectionChanged="ScenarioTab_SelectionChanged">
								<TabStripItem>XML</TabStripItem>
								<TabStripItem>3D View</TabStripItem>
							</TabStrip>
							<Grid Grid.Row="1">
								<!-- _txtEditor is reparented here in ShowScenarioPreview to reuse its
									 large-doc / TextMate / folding pipeline. -->
								<ContentControl x:Name="_scenarioXmlHost" Background="#1c1c1c"/>
								<DockPanel x:Name="_scenario3dPanel" IsVisible="False">
									<controls:ScenarioInspectorPanel x:Name="_scenarioInspector"
																	 DockPanel.Dock="Right"/>
									<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
												HorizontalAlignment="Right" Margin="0,4,0,0">
										<CheckBox x:Name="_showScenarioEntitiesCheckbox"
												  Content="Entities"
												  IsChecked="True"
												  IsCheckedChanged="ShowScenarioEntities_Toggled"
												  Margin="0,0,8,0" />
										<CheckBox x:Name="_showScenarioWaterCheckbox"
												  Content="Water"
												  IsChecked="True"
												  IsCheckedChanged="ShowScenarioWater_Toggled"
												  Margin="0,0,8,0" />
									</StackPanel>
									<Grid>
										<Border x:Name="_scenarioCanvasContainer" Background="#0a0a0a"/>
										<Button HorizontalAlignment="Left" VerticalAlignment="Top"
												Margin="8,8,0,0" Padding="6,3"
												Background="#202020" Foreground="#cfd8e8"
												BorderBrush="#404040" BorderThickness="1"
												ToolTip.Tip="Show controls and keyboard shortcuts">
											<StackPanel Orientation="Horizontal" Spacing="4">
												<micons:MaterialIcon Kind="InformationOutline" Width="14" Height="14"/>
												<TextBlock Text="Controls / Keys" FontSize="11"/>
											</StackPanel>
											<Button.Flyout>
												<Flyout Placement="Bottom">
													<ScrollViewer MaxWidth="420" MaxHeight="500"
																  VerticalScrollBarVisibility="Auto">
														<StackPanel Spacing="6" Margin="4">
															<TextBlock Text="MOUSE" FontWeight="Bold" Foreground="#ddd"/>
															<TextBlock Foreground="#bbb" FontSize="12">
															  <Run Text="Left drag" Foreground="#cfd8e8"/><Run Text=" - orbit camera"/><LineBreak/>
															  <Run Text="Right drag" Foreground="#cfd8e8"/><Run Text=" - pan camera"/><LineBreak/>
															  <Run Text="Wheel" Foreground="#cfd8e8"/><Run Text=" - zoom camera"/><LineBreak/>
															  <Run Text="Left click" Foreground="#cfd8e8"/><Run Text=" - select tile / entity"/><LineBreak/>
															  <Run Text="Ctrl + Left click" Foreground="#cfd8e8"/><Run Text=" - add to / toggle selection"/><LineBreak/>
															  <Run Text="Shift + Left click" Foreground="#cfd8e8"/><Run Text=" - box-select between last and clicked"/><LineBreak/>
															  <Run Text="Right click" Foreground="#cfd8e8"/><Run Text=" - clear selection"/><LineBreak/>
															  <Run Text="Ctrl + Right click" Foreground="#cfd8e8"/><Run Text=" - remove from selection"/>
															</TextBlock>
															<TextBlock Text="MOUSE - for selected entity" FontWeight="Bold" Foreground="#ddd" Margin="0,8,0,0"/>
															<TextBlock Foreground="#bbb" FontSize="12">
															  <Run Text="Left hold + drag" Foreground="#cfd8e8"/><Run Text=" - move entity"/><LineBreak/>
															  <Run Text="Right hold + drag" Foreground="#cfd8e8"/><Run Text=" - rotate entity"/><LineBreak/>
															  <Run Text="Right click cancels move; Left click cancels rotate"/>
															</TextBlock>
															<TextBlock Text="KEYS" FontWeight="Bold" Foreground="#ddd" Margin="0,8,0,0"/>
															<TextBlock Foreground="#bbb" FontSize="12">
															  <Run Text="Ctrl + S" Foreground="#cfd8e8"/><Run Text=" - Save (visible after first Save As)"/><LineBreak/>
															  <Run Text="Ctrl + Shift + S" Foreground="#cfd8e8"/><Run Text=" - Save As..."/><LineBreak/>
															  <Run Text="Ctrl + Z" Foreground="#cfd8e8"/><Run Text=" - Undo"/><LineBreak/>
															  <Run Text="Ctrl + Shift + Z" Foreground="#cfd8e8"/><Run Text=" - Redo"/>
															</TextBlock>
														</StackPanel>
													</ScrollViewer>
												</Flyout>
											</Button.Flyout>
										</Button>
										<Border x:Name="_scenarioErrorPanel"
												IsVisible="False"
												Background="#0a0a0a"
												HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
											<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
												<TextBlock x:Name="_scenarioErrorText"
														   Foreground="#ddd"
														   FontSize="14"
														   HorizontalAlignment="Center"/>
											</StackPanel>
										</Border>
										<Border x:Name="_scenarioProgressOverlay"
												IsVisible="False"
												Background="#a0000000"
												HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
											<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
												<TextBlock x:Name="_scenarioProgressText"
														   Foreground="#ddd"
														   HorizontalAlignment="Center"/>
												<ProgressBar x:Name="_scenarioProgressBar"
															 Width="240" Height="6"
															 Minimum="0" Maximum="1"/>
											</StackPanel>
										</Border>
									</Grid>
								</DockPanel>
							</Grid>
						</Grid>
					</Grid>
				</DockPanel>
			</Grid>
		</Border>
	</DockPanel>
</Window>

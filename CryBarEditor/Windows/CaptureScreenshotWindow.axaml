<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ce="using:CryBarEditor.Windows"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="300"
        x:Class="CryBarEditor.Windows.CaptureScreenshotWindow"
		x:DataType="ce:CaptureScreenshotWindow"
		WindowStartupLocation="CenterOwner"
		WindowDecorations="None"
		ExtendClientAreaToDecorationsHint="True"
		Foreground="#d9d9d9"
		Background="#141414"
		DataContext="{Binding RelativeSource={RelativeSource Self}}"
		CanResize="False" Width="380" Height="300"
        Title="Capture Screenshot">
	<Border Padding="10" BorderThickness="2" BorderBrush="#d9d9d9">
		<DockPanel>
			<TextBlock DockPanel.Dock="Top" Text="Capture Screenshot" FontWeight="Bold" FontSize="18" Margin="0,0,0,10" />

			<Grid DockPanel.Dock="Bottom" Margin="0,10,0,0" ColumnDefinitions="*,Auto,Auto">
				<StackPanel Grid.Column="0" Spacing="4"
							VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,8,0"
							IsVisible="{Binding IsBusy}">
					<TextBlock Text="Rendering..." Foreground="Gray" FontSize="12" />
					<ProgressBar IsIndeterminate="True" Width="80" Height="6" HorizontalAlignment="Left" />
				</StackPanel>
				<Button Grid.Column="1" Content="Confirm" Click="ConfirmClick" IsDefault="True"
						IsEnabled="{Binding !IsBusy}" />
				<Button Grid.Column="2" Content="Cancel" Click="CancelClick" IsCancel="True" Margin="8,0,0,0"
						IsEnabled="{Binding !IsBusy}" />
			</Grid>

			<TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorText}"
					   Foreground="#e05555" FontSize="12" TextWrapping="Wrap"
					   IsVisible="{Binding HasError}" Margin="0,8,0,0" />

			<StackPanel Margin="0,4,0,0" Spacing="10" IsEnabled="{Binding !IsBusy}">
				<DockPanel>
					<TextBlock Text="Render scale" VerticalAlignment="Center" Width="120" />
					<StackPanel Orientation="Horizontal" Spacing="10">
						<ComboBox ItemsSource="{Binding FactorLabels}"
								  SelectedIndex="{Binding FactorIndex}"
								  MinWidth="90" />
						<TextBlock Text="{Binding ResolutionText}" Foreground="Gray" VerticalAlignment="Center" />
					</StackPanel>
				</DockPanel>

				<CheckBox Content="Transparent background" IsChecked="{Binding Transparent}" />

				<DockPanel>
					<TextBlock Text="Format" VerticalAlignment="Center" Width="120" />
					<ComboBox ItemsSource="{Binding FormatLabels}"
							  SelectedIndex="{Binding FormatIndex}"
							  MinWidth="90" HorizontalAlignment="Left" />
				</DockPanel>

				<TextBlock Text="PNG produces much larger files; wider compatibility."
						   Foreground="#909090" FontSize="12" TextWrapping="Wrap"
						   IsVisible="{Binding IsPngSelected}" />
			</StackPanel>
		</DockPanel>
	</Border>
</Window>
